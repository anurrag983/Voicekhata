# Copy to .env and replace the secret with a random value before starting.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Local development uses SQLite. Set a PostgreSQL URL when deploying or sharing data.
DATABASE_URL=sqlite:///./voicekhata.db

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Add your Gnani API key from your account dashboard. Keep it server-side.
GNANI_API_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/sse
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_AUDIO_BYTES=15728640
ACCESS_TOKEN_MINUTES=720

# Optional: OTP delivery via Email (SMTP / Gmail)
# If left blank, OTPs are printed to the server terminal in dev mode.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-gmail-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com

# Optional: OTP delivery via SMS (Fast2SMS or Twilio)
# FAST2SMS_API_KEY=your-fast2sms-api-key
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
